# ------------------------------------------------------------
# CheckoutPilot environment variables
#
# 1. Copy this file and name the copy ".env"
#       Windows:      copy .env.example .env
#       macOS/Linux:  cp .env.example .env
# 2. Fill in your own values in .env
# 3. NEVER commit .env to GitHub (it is already in .gitignore)
# ------------------------------------------------------------

# --- App settings ---
APP_ENV=development
BACKEND_URL=http://localhost:8000
# Comma-separated list of origins allowed to call the backend
# (5173 = React dashboard via `npm run dev`, 8501 = old Streamlit page)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501
# The demo stores run on localhost; scanning them needs this (only loopback is allowed)
ALLOW_LOCALHOST_SCANS=true

# --- AI provider (fill in only the one your team uses) ---
# AI_PROVIDER / AI_MODEL are used by the AI engine (vision checks).
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_VISION_ENABLED=true
AI_TIMEOUT_SECONDS=120

# Google Gemini (free tier via Google AI Studio: https://aistudio.google.com/)
GOOGLE_API_KEY=your-google-api-key-here

# --- Code agent (FIX step). Its own settings so they never change the AI engine. ---
# Provider: gemini | nvidia | ollama | openai | anthropic (default: same as AI_PROVIDER)
# CODE_AGENT_PROVIDER=gemini
# CODE_AGENT_MODEL=gemini-3.8-flash
# NVIDIA NIM (free credits via https://build.nvidia.com/)
NVIDIA_API_KEY=your-nvidia-api-key-here
# CODE_AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
# Local Ollama (free, offline):
# CODE_AGENT_PROVIDER=ollama
# CODE_AGENT_BASE_URL=http://localhost:11434/v1
# CODE_AGENT_MODEL=qwen2.5-coder

# Other providers (optional)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: limit where the v6 browser client token may be used (comma-separated)
PAYPAL_CLIENT_TOKEN_DOMAINS=

# --- PayPal Sandbox test buyer (Testing Tools > Sandbox Accounts) ---
# Must be a UNITED STATES *Personal* account, never the Business (seller) one.
PAYPAL_SANDBOX_BUYER_EMAIL=buyer-sandbox-email@example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=your-sandbox-buyer-password-here

# Sandbox verifier: false = show the browser while it pays (good for demos)
VERIFY_HEADLESS=true

# --- Mocks: "true" = fake results, no PayPal / browser needed ---
MOCK_PAYPAL=false
MOCK_VERIFIER=false

# --- GitHub (for the code agent to open pull requests) ---
GITHUB_TOKEN=your-github-personal-access-token-here

# --- Hosted mode (Render / Docker). Leave unset for local development. ---
# START_DEMO_STORES=true        start the example stores inside the backend
# DASHBOARD_DIR=/app/dashboard  serve the built dashboard from the backend's URL
# RATE_LIMIT_PER_HOUR=30        scans/fixes/proofs per visitor per hour (0 = off)
# OUTPUTS_MAX_AGE_HOURS=24      delete old screenshots and patched copies
# ASYNC_JOBS=true               long steps return a job id the dashboard polls (hosted servers)
# FREE_TIER=true                fit into a 512 MB free plan (Render free): low-memory mode
# CORS_ORIGIN_REGEX=...         let a separately hosted dashboard call the API (e.g. Vercel)
