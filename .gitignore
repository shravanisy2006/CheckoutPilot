# --- Secrets: never commit these ---
.env
.env.*
!.env.example

# --- Python virtual environments ---
venv/
.venv/
env/
ENV/

# --- Python caches and build files ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Streamlit secrets ---
.streamlit/secrets.toml
frontend/.streamlit/secrets.toml

# --- Generated output (screenshots, reports, browser traces) ---
outputs/
screenshots/
reports/
playwright-report/
test-results/
*.log

# --- Editors and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
